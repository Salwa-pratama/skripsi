# =========================================================================
# Asisten Belajar AI - konfigurasi server
# =========================================================================

# Suara TTS default: cowok (id-ID-ArdiNeural) atau cewek (id-ID-GadisNeural)
VOICE_GENDER=cowok

# Model Speech-to-Text lokal (faster-whisper): tiny / base / small / medium
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=id

# Ambang cosine similarity minimal. Di bawah ini dianggap di luar kurikulum.
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=3

# Lokasi artefak model (default: computer-vision/model/output_artifacts)
# ARTIFACTS_DIR=/path/ke/computer-vision/model/output_artifacts

# Database Connection URL (MySQL / MariaDB)
DATABASE_URL=mysql+pymysql://asisten:password@localhost:3306/asisten_belajar_db?charset=utf8mb4
